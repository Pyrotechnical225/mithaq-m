{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://oxhpvawqmrdvkrlntswl.supabase.co/auth/v1",
    "accepted_audiences": ["authenticated"]
  },
  "mcp": {
    "server": {
      "name": "mithaq-mcp",
      "version": "0.1.0",
      "title": "Mithaq"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in Mithaq user's profile row (display name, contact email).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_my_survey",
        "title": "Get my survey answers",
        "description": "Return the signed-in user's Mithaq survey answers and completion state.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "save_my_survey",
        "title": "Save my survey answers",
        "description": "Upsert the signed-in user's Mithaq survey answers. Answers is a map of question id (string) to answer text. Set completed=true only after all required questions (1-30) are filled.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "answers": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              },
              "description": "Map of question id to answer text."
            },
            "completed": {
              "type": "boolean",
              "description": "Whether the survey is fully completed."
            }
          },
          "required": ["answers", "completed"]
        },
        "outputSchema": null
      },
      {
        "name": "get_privacy_settings",
        "title": "Get privacy settings",
        "description": "Return the signed-in user's Mithaq privacy settings (visibility, field visibility).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_privacy_settings",
        "title": "Update privacy settings",
        "description": "Update the signed-in user's Mithaq privacy settings.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "visibility": {
              "type": "string",
              "enum": ["discoverable", "paused", "hidden"]
            },
            "show_location": {
              "type": "boolean"
            },
            "show_occupation": {
              "type": "boolean"
            },
            "show_free_text": {
              "type": "boolean"
            },
            "reveal_contact_on_mutual": {
              "type": "boolean"
            }
          },
          "required": [
            "visibility",
            "show_location",
            "show_occupation",
            "show_free_text",
            "reveal_contact_on_mutual"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
