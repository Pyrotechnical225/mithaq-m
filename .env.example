# Copy to .env and fill in. Never commit .env — it is gitignored.
# Values here are names only; no real credentials belong in this file.

# --- Supabase -----------------------------------------------------------
# Server-side (used by requireSupabaseAuth and the server Supabase client).
# The URL and project ID must match the VITE_* values below. Builds fail closed
# when the browser and server point at different Supabase projects.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Service-role key. Bypasses RLS — server only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (inlined into the browser bundle by Vite; publishable only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_ENABLE_GOOGLE_AUTH=true
# Canonical browser callback origin for email confirmation and OAuth.
VITE_PUBLIC_SITE_URL=https://www.mithaq.uk

# Optional outside Vercel. Vercel-hosted URLs are detected automatically.
VITE_ENABLE_VERCEL_OBSERVABILITY=false

# --- OpenAI-compatible provider ----------------------------------------
# Optional. Without a key, compatibility scoring falls back to the fixed
# rubric only. OPENAI_MODEL defaults to DEFAULT_OPENAI_MODEL in
# src/lib/openai-compatibility.server.ts.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Stripe -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_RESTRICTED_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Canonical domain currently redirects mithaq.uk to www.mithaq.uk.
PUBLIC_SITE_URL=https://www.mithaq.uk
ALLOW_EXAMPLE_DATA=false
EXAMPLE_USER_PASSWORD=

# --- Amazon SES application notifications (server only) -------------------
# Keep disabled until the migration, member controls, SES identity and schedule
# have been verified together. Never set these as VITE_* variables.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_DEPLOYMENT_SCOPE=
AWS_REGION=eu-north-1
# Vercel OIDC assumes this SES-only role with one-hour credentials. Do not use
# long-lived AWS access keys.
AWS_ROLE_ARN=
SES_FROM_EMAIL=no-reply@mithaq.uk
SES_REPLY_TO_EMAIL=
# A separate random secret of at least 32 characters for the job endpoint.
NOTIFICATION_CRON_SECRET=
